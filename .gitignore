# Environment
.env

# Rust
/target
# Cargo.lock is COMMITTED (binary crate): releases build with --locked so the
# artifact is reproducible and immune to semver-compatible upstream surprises.

# SQLx offline cache (generate with `cargo sqlx prepare`)
/.sqlx

# Database
*.sqlite
*.sqlite-shm
*.sqlite-wal

# OS
.DS_Store

# Legacy Zig artifacts (deprecated)
zig-backend/main
zig-backend/bind_wrapper.o
zig-backend/file_wrapper.o
zig-backend/signal_wrapper.o

# Local ingestion dumps — user drops research artifacts here for later processing
ingest/
node_modules/

# Re-score review exports (scripts/export_sec01_trials.py). Regenerable from the DB
# at any time and bulky (carries raw_response), so it is not tracked. The EXPORT is
# the shareable artifact; the CSV is a local convenience.
analysis/sec01_trials_export.csv
